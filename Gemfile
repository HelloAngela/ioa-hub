source "https://rubygems.org"

# The same Jekyll version that GitHub Pages uses (3.10).
# The all-in-one "github-pages" package does not run on Ruby 4 yet,
# so the local preview uses Jekyll directly. The site uses no plugins,
# so the result is the same.
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm"

# Needed to run the local preview.
gem "webrick"

# Parts of Ruby that newer Ruby versions (3.4 and later) no longer include by default.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"

# Needed on Windows.
gem "tzinfo-data", platforms: %i[windows jruby]
